{
  "name": "MarketMind M1 — full loop (import on the day; creds via $env)",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } }, "id": "n1", "name": "Every ~5 min", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },
    { "parameters": { "method": "POST", "url": "=https://api.apify.com/v2/acts/{{ $env.APIFY_ACTOR_LISTINGS }}/run-sync-get-dataset-items?token={{ $env.APFY_TOKEN }}", "sendBody": true, "specifyBody": "json", "jsonBody": "={\"search\":\"nintendo switch OR canon lens OR ps4\",\"maxItems\":25}" }, "id": "n2", "name": "Apify — listings (NOTICE)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [200, 0] },
    { "parameters": { "jsCode": "// seen-ids dedupe (T09) — persist via workflow static data\nconst sd = $getWorkflowStaticData('global'); sd.seen = sd.seen || {};\nitems = items.filter(it => { if (sd.seen[it.json.id]) return false; sd.seen[it.json.id] = Date.now(); return true; });\nreturn items;" }, "id": "n3", "name": "seen-ids dedupe", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [400, 0] },
    { "parameters": { "jsCode": "// margin_z is COMPUTED here from comps (Art V.2: never asked of a model)\n// + kill-switch check (Art VII.3) — paste body from app/mm/decide.py logic / keep in sync\nconst paused = $env.AUTO_PAUSE === '1';\nfor (const it of items) { const c = it.json.comps || {}; it.json.facts = { ...(it.json.facts||{}), margin_z: it.json.margin_z ?? null }; it.json.over_cap = paused; }\nreturn items;" }, "id": "n4", "name": "price + facts (code)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [600, 0] },
    { "parameters": { "method": "POST", "url": "={{ $env.TF_BASE_URL || 'https://api.openai.com/v1' }}/chat/completions", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.TF_API_KEY || $env.OPENAI_API_KEY }}" }] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"model\":\"{{ $env.MODEL_JUDGE }}\",\"response_format\":{\"type\":\"json_object\"},\"messages\":[{\"role\":\"system\",\"content\":\"6 typed questions, closed sets, strict JSON (skin/questions.json)\"},{\"role\":\"user\",\"content\":\"{{ JSON.stringify($json.text) }}\"}]}" }, "id": "n5", "name": "MODEL_JUDGE (strict JSON)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [800, 0] },
    { "parameters": { "jsCode": "// POLICY (fail-closed) — paste app/n8n/policy_v1_node.js body here (v0: policy_v0_node.js).\n// Oracle parity (Art II.4): app/tests/test_gate_parity.py must stay green after ANY edit.\n// judge_answers null => escalate-all (judge=unconfigured)." }, "id": "n6", "name": "POLICY (fail-closed)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1000, 0] },
    { "parameters": { "rules": { "values": [ { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "leftValue": "={{ $json.action_state }}", "rightValue": "drafted", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "drafted" }, { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "leftValue": "={{ $json.action_state }}", "rightValue": "escalated", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "escalated" } ] } }, "id": "n7", "name": "route by action_state", "type": "n8n-nodes-base.switch", "typeVersion": 3, "position": [1200, 0] },
    { "parameters": { "chatId": "={{ $env.TELEGRAM_CHAT_ID }}", "text": "=DRAFT (drafted != sent): {{ $json.title }} — {{ $json.draft.text_nl }}\n[approve] [override→escalate]", "additionalFields": {} }, "id": "n8", "name": "Telegram — draft-assist", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1400, -100] },
    { "parameters": { "chatId": "={{ $env.TELEGRAM_CHAT_ID }}", "text": "=ESCALATE: {{ $json.title }} · {{ $json.gate.reason_codes.join(',') }} · tier {{ $json.tier }}", "additionalFields": {} }, "id": "n9", "name": "Telegram — escalation", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1400, 100] },
    { "parameters": { "operation": "create", "base": { "__rl": true, "value": "={{ $env.AIRTABLE_BASE }}", "mode": "id" }, "table": { "__rl": true, "value": "={{ $env.AIRTABLE_TABLE }}", "mode": "id" }, "columns": { "mappingMode": "defineBelow", "value": { "receipt_id": "={{ $json.receipt_id }}", "ts": "={{ $json.ts }}", "input_hash": "={{ $json.input_hash }}", "action_state": "={{ $json.action_state }}", "reason_codes": "={{ ($json.gate.reason_codes || []).join(',') }}", "policy_branch": "={{ 'gate:' + ($json.gate.action||'') }}", "tier": "={{ $json.tier }}", "actor": "agent" }, "matchingColumns": ["receipt_id"], "attemptToMatchTypes": false }, "options": {} }, "id": "n10", "name": "Airtable — receipt (T18)", "type": "n8n-nodes-base.airtable", "typeVersion": 2.1, "position": [1600, 0] }
  ],
  "connections": {
    "Every ~5 min": { "main": [[{ "node": "Apify — listings (NOTICE)", "type": "main", "index": 0 }]] },
    "Apify — listings (NOTICE)": { "main": [[{ "node": "seen-ids dedupe", "type": "main", "index": 0 }]] },
    "seen-ids dedupe": { "main": [[{ "node": "price + facts (code)", "type": "main", "index": 0 }]] },
    "price + facts (code)": { "main": [[{ "node": "MODEL_JUDGE (strict JSON)", "type": "main", "index": 0 }]] },
    "MODEL_JUDGE (strict JSON)": { "main": [[{ "node": "POLICY (fail-closed)", "type": "main", "index": 0 }]] },
    "POLICY (fail-closed)": { "main": [[{ "node": "route by action_state", "type": "main", "index": 0 }]] },
    "route by action_state": { "main": [[{ "node": "Telegram — draft-assist", "type": "main", "index": 0 }], [{ "node": "Telegram — escalation", "type": "main", "index": 0 }]] },
    "Telegram — draft-assist": { "main": [[{ "node": "Airtable — receipt (T18)", "type": "main", "index": 0 }]] },
    "Telegram — escalation": { "main": [[{ "node": "Airtable — receipt (T18)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "note": "M1 full loop (T06/T09/T11/T14/T18). Digest = separate 07:30 schedule reading Airtable/receipts (WIRING.md). Sources of truth: skin/policy.py + app/n8n/*.js mirrors. Inbound buyer triage (T12) = second workflow calling mm/inbound.py rules. Browser actions (T13) via mm/browser_act.py allowlist." }
}
